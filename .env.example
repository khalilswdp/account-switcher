# Copy to .env (gitignored). Real environment variables win over this file.
# The dashboard and every script in scripts/ read it.

# Protected accounts (comma list, default "main"): switched to, saved to the Vault and backed up like
# any other, but never removed from this computer, and nothing of theirs can be deleted from the dashboard.
PROTECTED_ACCOUNTS=main

# Windows only, normally not needed: the Claude app's Claude.exe, when the dashboard cannot find it
# through the claude:// link handler the app registers.
# CLAUDE_DESKTOP_EXE=C:\Users\you\AppData\Local\AnthropicClaude\claude.exe

# The Vault the dashboard and the scripts use. Once the local Docker Vault is set up
# (node scripts/vault-local.mjs init), these two are the defaults even when left out.
# VAULT_PROVIDER=hashicorp
# VAULT_ADDR=http://127.0.0.1:8200

# Another image for the local Vault container, for when the pinned one cannot be pulled. Take a
# snapshot first (node scripts/vault-local.mjs backup <file>) before changing versions.
# VAULT_IMAGE=hashicorp/vault:2.2.1
